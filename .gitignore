# Unreal project lives in unmasked/. Keep these rules scoped there because this
# file sits beside the repository-wide .gitattributes file.

# Visual Studio user-specific files
unmasked/.vs/
unmasked/**/.vs/

# Compiled object files
unmasked/**/*.slo
unmasked/**/*.lo
unmasked/**/*.o
unmasked/**/*.obj

# Precompiled headers
unmasked/**/*.gch
unmasked/**/*.pch

# Compiled dynamic libraries
unmasked/**/*.so
unmasked/**/*.dylib
unmasked/**/*.dll

# Fortran module files
unmasked/**/*.mod

# Compiled static libraries
unmasked/**/*.lai
unmasked/**/*.la
unmasked/**/*.a
unmasked/**/*.lib

# Executables
unmasked/**/*.exe
unmasked/**/*.out
unmasked/**/*.app
unmasked/**/*.ipa

# Generated IDE/project files
unmasked/**/*.xcodeproj
unmasked/**/*.xcworkspace
unmasked/**/*.sln
unmasked/**/*.suo
unmasked/**/*.opensdf
unmasked/**/*.sdf
unmasked/**/*.VC.db
unmasked/**/*.VC.opendb
unmasked/**/*.vsconfig

# Precompiled source assets
unmasked/SourceArt/**/*.png
unmasked/SourceArt/**/*.tga

# Binary files
unmasked/Binaries/*
unmasked/Plugins/**/Binaries/*

# Build outputs
unmasked/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!unmasked/Build/*/
unmasked/Build/*/**
!unmasked/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!unmasked/Build/**/*.ico

# Built data for maps
unmasked/**/*_BuiltData.uasset

# Configuration files generated by the Editor
unmasked/Saved/*

# Compiled source files for the engine to use
unmasked/Intermediate/*
unmasked/Plugins/**/Intermediate/*

# Cache files for the editor to use
unmasked/DerivedDataCache/*
